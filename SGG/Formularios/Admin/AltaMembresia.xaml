<Window x:Class="SGG.Formularios.Admin.AltaMembresia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGG - Membresía" Height="520" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="440" MinWidth="400"
        Background="#0D0D0D">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="35">

            <TextBlock x:Name="txtTitulo" Text="NUEVA MEMBRESÍA" FontSize="20" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,25"/>

            <TextBlock Text="Actividad" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbActividad" Height="34"
                      Margin="0,0,0,15">
                <ComboBoxItem Content="Musculación" Tag="Musculacion"/>
                <ComboBoxItem Content="Funcional" Tag="Funcional"/>
                <ComboBoxItem Content="Combinado" Tag="Combinado"/>
            </ComboBox>

            <TextBlock Text="Precio" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPrecio" Height="34"
                     Background="#1A1A1A" Foreground="White" BorderBrush="#333333"
                     Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <!-- Fecha inicio + vencimiento -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fecha inicio" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpInicio" Height="34" 
                                Background="#1A1A1A" Foreground="White"
                                Margin="0,0,0,15"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fecha vencimiento" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpVencimiento" Height="34"
                                Background="#1A1A1A" Foreground="White"
                                Margin="0,0,0,15"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="txtError"
                       Foreground="#FF5555" FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"
                       Visibility="Collapsed"/>

            <Button x:Name="btnGuardar" Content="GUARDAR MEMBRESÍA" Height="38"
                    Background="#C5FF00" Foreground="Black" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Click="btnGuardar_Click"/>

        </StackPanel>

    </ScrollViewer>
</Window>
