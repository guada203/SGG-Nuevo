<UserControl x:Class="SGG.Formularios.Admin.GestionMembresias"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título + botón nuevo -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="GESTIÓN DE MEMBRESÍAS" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtCantidadMembresias" Text="0 membresías registradas" 
                           FontSize="13" Foreground="#888888" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Content="+ NUEVA MEMBRESÍA" HorizontalAlignment="Right" 
                    Background="#C5FF00" Foreground="Black" FontWeight="Bold" 
                    Padding="18,10" BorderThickness="0" Cursor="Hand"
                    Click="btnNuevaMembresia_Click"/>
        </Grid>

        <!-- Buscador -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Grid Width="380" Height="36">
                <TextBox x:Name="txtBuscar"
                         Style="{StaticResource TextBoxConPlaceholder}"
                         VerticalContentAlignment="Center"
                         TextChanged="txtBuscar_TextChanged"/>
                <TextBlock x:Name="hintBuscar" Text="Buscar por actividad o estado..."
                           Foreground="#666666" VerticalAlignment="Center" Margin="8,0,0,0"
                           IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

        <!-- Tabla de membresías -->
        <DataGrid x:Name="dgMembresias" Grid.Row="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad}" Width="200"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="120"/>
                <DataGridTextColumn Header="Vence" Binding="{Binding Vence}" Width="130"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                <DataGridTemplateColumn Header="Acciones" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏️ Editar" Style="{StaticResource BotonAccion}" Margin="0,0,6,0"
                                        Click="btnEditar_Click" Tag="{Binding Id}"/>
                                <Button Content="Dar de baja" Style="{StaticResource BotonAccion}"
                                        Foreground="#FF5555"
                                        Click="btnDarBaja_Click" Tag="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>