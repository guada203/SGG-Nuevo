<Window x:Class="SGG.Formularios.Admin.GestionMembresias"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:SGG.Controles"
        Title="SGG - Gestión de Membresías" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <controles:MenuLateral x:Name="menuLateral" Grid.Column="0" SeccionActiva="Membresias" />

        <!-- Contenido principal -->
        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título + botón nuevo -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="GESTIÓN DE MEMBRESÍAS" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtCantidadMembresias" Text="0 membresías registradas" 
                               FontSize="13" Foreground="#888888" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="+ NUEVA MEMBRESÍA" HorizontalAlignment="Right" 
                        Background="#C5FF00" Foreground="Black" FontWeight="Bold" 
                        Padding="18,10" BorderThickness="0" Cursor="Hand"
                        Click="btnNuevaMembresia_Click"/>
            </Grid>

            <!-- Buscador -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBox x:Name="txtBuscar" Width="380" Height="36" 
                         Background="#1A1A1A" Foreground="White" BorderBrush="#333333" 
                         Padding="12,0" VerticalContentAlignment="Center" 
                         TextChanged="txtBuscar_TextChanged"/>
            </StackPanel>

            <!-- Tabla de membresías -->
            <DataGrid x:Name="dgMembresias" Grid.Row="2" 
                      Background="#0D0D0D" Foreground="White" BorderThickness="0"
                      RowBackground="#0D0D0D" AlternatingRowBackground="#151515"
                      AutoGenerateColumns="False" IsReadOnly="True" 
                      GridLinesVisibility="None" HeadersVisibility="Column"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad}" Width="200"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding Precio}" Width="120"/>
                    <DataGridTextColumn Header="Vence" Binding="{Binding Vence}" Width="130"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120"/>
                    <DataGridTemplateColumn Header="Acciones" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="EDITAR" Padding="10,4" Margin="0,0,6,0"
                                            Click="btnEditar_Click" Tag="{Binding Id}"/>
                                    <Button Content="DAR DE BAJA" Padding="10,4" 
                                            Foreground="#FF5555"
                                            Click="btnDarBaja_Click" Tag="{Binding Id}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</Window>
