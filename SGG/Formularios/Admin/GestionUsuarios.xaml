<Window x:Class="SGG.Formularios.Admin.GestionUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:SGG.Controles"
        Title="SGG - Gestión de Usuarios" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <controles:MenuLateral x:Name="menuLateral" Grid.Column="0" SeccionActiva="Usuarios" />

        <!-- Contenido principal -->
        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título + botón nuevo -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="GESTIÓN DE USUARIOS" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtCantidadUsuarios" Text="0 usuarios registrados en el sistema" 
                               FontSize="13" Foreground="#888888" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="+ NUEVO USUARIO" HorizontalAlignment="Right" 
                        Background="#C5FF00" Foreground="Black" FontWeight="Bold" 
                        Padding="18,10" BorderThickness="0" Cursor="Hand"
                        Click="btnNuevoUsuario_Click"/>
            </Grid>

            <!-- Tarjetas resumen -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="#1A1A1A" BorderBrush="#C5FF00" BorderThickness="0,2,0,0" 
                        Width="220" Height="90" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock Text="ADMINISTRADORES ACTIVOS" FontSize="10" Foreground="#888888"/>
                        <TextBlock x:Name="txtCantAdmins" Text="0" FontSize="24" FontWeight="Bold" 
                                   Foreground="#C5FF00" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1A1A" BorderBrush="#3B82F6" BorderThickness="0,2,0,0" 
                        Width="220" Height="90" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock Text="RECEPCIONISTAS ACTIVOS" FontSize="10" Foreground="#888888"/>
                        <TextBlock x:Name="txtCantRecepcionistas" Text="0" FontSize="24" FontWeight="Bold" 
                                   Foreground="#3B82F6" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A1A1A" BorderBrush="#A855F7" BorderThickness="0,2,0,0" 
                        Width="220" Height="90">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock Text="ENTRENADORES ACTIVOS" FontSize="10" Foreground="#888888"/>
                        <TextBlock x:Name="txtCantEntrenadores" Text="0" FontSize="24" FontWeight="Bold" 
                                   Foreground="#A855F7" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Buscador -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBox x:Name="txtBuscar" Width="380" Height="36" 
                         Background="#1A1A1A" Foreground="White" BorderBrush="#333333" 
                         Padding="12,0" VerticalContentAlignment="Center" 
                         TextChanged="txtBuscar_TextChanged"/>
            </StackPanel>

            <!-- Tabla de usuarios -->
            <DataGrid x:Name="dgUsuarios" Grid.Row="3" 
                      Background="#0D0D0D" Foreground="White" BorderThickness="0"
                      RowBackground="#0D0D0D" AlternatingRowBackground="#151515"
                      AutoGenerateColumns="False" IsReadOnly="True" 
                      GridLinesVisibility="None" HeadersVisibility="Column"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Nombre}" Width="200"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                    <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="140"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                    <DataGridTemplateColumn Header="Activo" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding EsActivo, Mode=OneWay}" 
                                              Click="ToggleActivo_Click" 
                                              Tag="{Binding Id}"
                                              Style="{StaticResource ToggleSwitch}"
                                              HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Acciones" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="EDITAR" Padding="10,4"
                                        Click="btnEditar_Click" Tag="{Binding Id}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</Window>