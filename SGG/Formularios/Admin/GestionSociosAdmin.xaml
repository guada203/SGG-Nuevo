<UserControl x:Class="SGG.Formularios.Admin.GestionSociosAdmin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Botón de baja/reactivación: esquinas redondeadas y color semántico.
             Rojo para DAR DE BAJA, verde para REACTIVAR (el Color cambia con el texto del botón). -->
        <Style x:Key="BotonBaja" TargetType="Button">
            <Setter Property="Background" Value="#2B1515"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderBrush" Value="#FF5555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- REACTIVAR: cambia la paleta a verde -->
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="REACTIVAR">
                    <Setter Property="Background" Value="#16261B"/>
                    <Setter Property="Foreground" Value="#4ADE80"/>
                    <Setter Property="BorderBrush" Value="#4ADE80"/>
                </DataTrigger>
                <!-- Hover/pressed del estado rojo (DAR DE BAJA) -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A1D1D"/>
                    <Setter Property="BorderBrush" Value="#FF7777"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4A2525"/>
                </Trigger>
                <!-- Hover/pressed del estado verde (REACTIVAR) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="REACTIVAR"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#1E3A26"/>
                    <Setter Property="BorderBrush" Value="#6BE7A0"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="REACTIVAR"/>
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#275033"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="GESTIÓN DE SOCIOS" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtCantidadSocios" Text="0 socios registrados" 
                           FontSize="13" Foreground="#888888" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Buscador -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Grid Width="380" Height="36">
                <TextBox x:Name="txtBuscar"
                         Style="{StaticResource TextBoxConPlaceholder}"
                         VerticalContentAlignment="Center"
                         TextChanged="txtBuscar_TextChanged"/>
                <TextBlock x:Name="hintBuscar" Text="Buscar por nombre o DNI..."
                           Foreground="#666666" VerticalAlignment="Center" Margin="8,0,0,0"
                           IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

        <!-- Tabla de socios -->
        <DataGrid x:Name="dgSocios" Grid.Row="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Socio" Binding="{Binding NombreCompleto}" Width="200"/>
                <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="110"/>
                <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="130"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                <DataGridTemplateColumn Header="Acciones" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="btnBaja" Content="{Binding AccionBaja}"
                                    Style="{StaticResource BotonBaja}"
                                    Click="btnBaja_Click" Tag="{Binding Id}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>