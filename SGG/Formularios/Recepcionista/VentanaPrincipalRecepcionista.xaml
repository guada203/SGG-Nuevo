<Window x:Class="SGG.Formularios.Recepcionista.VentanaPrincipalRecepcionista"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGG - Recepcionista" Height="600" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,30,0,0">

                <TextBlock Text="SGG" FontSize="22" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="RECEPCIONISTA" FontSize="10" Foreground="#3B82F6" 
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Button x:Name="btnInicio" Content="🏠  Inicio" 
                        Style="{StaticResource BotonMenu}" Click="btnInicio_Click"/>
                <Button x:Name="btnSocios" Content="🧑  Socios" 
                        Style="{StaticResource BotonMenu}" Click="btnSocios_Click"/>
                <Button x:Name="btnPagos" Content="💳  Pagos" 
                        Style="{StaticResource BotonMenu}" Click="btnPagos_Click"/>
                <Button x:Name="btnAsistencia" Content="✅  Asistencia" 
                        Style="{StaticResource BotonMenu}" Click="btnAsistencia_Click"/>

                <Border Height="1" Background="#2A2A2A" Margin="20,30,20,20"/>

                <Button x:Name="btnCerrarSesion" Content="⏻  Cerrar sesión" 
                        Style="{StaticResource BotonMenu}" 
                        Foreground="#FF5555" Click="btnCerrarSesion_Click"/>

            </StackPanel>
        </Border>

        <!-- Panel principal -->
        <StackPanel Grid.Column="1" Margin="35">

            <TextBlock Text="Panel de Recepcionista" FontSize="24" FontWeight="Bold" 
                       Foreground="White" Margin="0,0,0,5"/>
            <TextBlock Text="Resumen del día" FontSize="13" 
                       Foreground="#888888" Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal">

                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" 
                        CornerRadius="6" Width="180" Height="100" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock Text="Socios activos" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="txtTotalSocios" Text="—" FontSize="26" FontWeight="Bold" 
                                   Foreground="#3B82F6" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" 
                        CornerRadius="6" Width="180" Height="100" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock Text="Ingresos hoy" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="txtIngresosHoy" Text="—" FontSize="26" FontWeight="Bold" 
                                   Foreground="#C5FF00" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" 
                        CornerRadius="6" Width="180" Height="100">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock Text="Cuotas por vencer" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="txtCuotasPorVencer" Text="—" FontSize="26" FontWeight="Bold" 
                                   Foreground="#FF5555" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </Grid>
</Window>