<Window x:Class="SGG.Formularios.Recepcionista.GestionSocios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGG - Gestión de Socios" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,30,0,0">
                <TextBlock Text="SGG" FontSize="22" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="RECEPCIONISTA" FontSize="10" Foreground="#3B82F6" 
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Button Content="🏠  Inicio" Style="{StaticResource BotonMenu}" Click="btnInicio_Click"/>
                <Button Content="🧑  Socios" Style="{StaticResource BotonMenu}" Background="#252525"/>
                <Button Content="💳  Pagos" Style="{StaticResource BotonMenu}" Click="btnPagos_Click"/>
                <Button Content="✅  Asistencia" Style="{StaticResource BotonMenu}" Click="btnAsistencia_Click"/>

                <Border Height="1" Background="#2A2A2A" Margin="20,30,20,20"/>
                <Button Content="⏻  Cerrar sesión" Style="{StaticResource BotonMenu}" 
                        Foreground="#FF5555" Click="btnCerrarSesion_Click"/>
            </StackPanel>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título + botón nuevo -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="GESTIÓN DE SOCIOS" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtCantidadSocios" Text="0 socios registrados" 
                               FontSize="13" Foreground="#888888" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="+ NUEVO SOCIO" HorizontalAlignment="Right" 
                        Background="#3B82F6" Foreground="White" FontWeight="Bold" 
                        Padding="18,10" BorderThickness="0" Cursor="Hand"
                        Click="btnNuevoSocio_Click"/>
            </Grid>

            <!-- Buscador -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <TextBox x:Name="txtBuscar" Width="380" Height="36" 
                         Background="#1A1A1A" Foreground="White" BorderBrush="#333333" 
                         Padding="12,0" VerticalContentAlignment="Center" 
                         TextChanged="txtBuscar_TextChanged"/>
            </StackPanel>

            <!-- Tabla de socios -->
            <DataGrid x:Name="dgSocios" Grid.Row="2" 
                      Background="#0D0D0D" Foreground="White" BorderThickness="0"
                      RowBackground="#0D0D0D" AlternatingRowBackground="#151515"
                      AutoGenerateColumns="False" IsReadOnly="True" 
                      GridLinesVisibility="None" HeadersVisibility="Column"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Socio" Binding="{Binding NombreCompleto}" Width="200"/>
                    <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="110"/>
                    <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="130"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                    <DataGridTextColumn Header="Vence" Binding="{Binding Vence}" Width="110"/>
                    <DataGridTemplateColumn Header="Acciones" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="EDITAR" Padding="10,4" Margin="0,0,6,0"
                                            Click="btnEditar_Click" Tag="{Binding Id}"/>
                                    <Button Content="DAR DE BAJA" Padding="10,4" 
                                            Foreground="#FF5555"
                                            Click="btnDarBaja_Click" Tag="{Binding Id}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</Window>