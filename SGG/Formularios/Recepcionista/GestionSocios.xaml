<UserControl x:Class="SGG.Formularios.Recepcionista.GestionSocios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título + botón nuevo -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="GESTIÓN DE SOCIOS" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtCantidadSocios" Text="0 socios registrados" 
                           FontSize="13" Foreground="#888888" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Content="➕ NUEVO SOCIO" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#3B82F6" Foreground="White" FontWeight="Bold" 
                    Padding="18,10" BorderThickness="0" Cursor="Hand"
                    Click="btnNuevoSocio_Click"/>
        </Grid>

        <!-- Buscador -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Grid Width="380" Height="36">
                <TextBox x:Name="txtBuscar"
                         Style="{StaticResource TextBoxConPlaceholder}"
                         TextChanged="txtBuscar_TextChanged"/>
                <TextBlock x:Name="hintBuscar" Text="Buscar por nombre o DNI..."
                           Foreground="#666666" VerticalAlignment="Center" Margin="8,0,0,0"
                           IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

        <!-- Tabla de socios -->
        <DataGrid x:Name="dgSocios" Grid.Row="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Socio" Binding="{Binding NombreCompleto}" Width="180"/>
                <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="110"/>
                <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="130"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                <DataGridTextColumn Header="Vence" Binding="{Binding Vence}" Width="110"/>
                <DataGridTemplateColumn Header="Acciones" Width="210">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Button Content="✏️ Editar" Style="{StaticResource BotonAccion}" Click="btnEditar_Click" Tag="{Binding Id}"
                                        Margin="0,0,6,0" Foreground="#3B82F6"/>
                                <Button Content="{Binding AccionBaja}" Style="{StaticResource BotonAccion}" Click="btnBaja_Click" Tag="{Binding Id}"
                                        Foreground="#FF5555"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>