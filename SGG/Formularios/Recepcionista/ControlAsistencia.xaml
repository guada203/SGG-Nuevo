<UserControl x:Class="SGG.Formularios.Recepcionista.ControlAsistencia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="CONTROL DE ASISTENCIA" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Registrar ingreso de socios y consultar historial" FontSize="13" 
                           Foreground="#888888" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Fila 1: formulario + ingresos de hoy -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Formulario de ingreso -->
            <Border Grid.Column="0" Background="#181818" BorderBrush="#3B82F6" BorderThickness="0,3,0,0" 
                    CornerRadius="8" Padding="18" Margin="0,0,15,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Registrar ingreso" FontSize="14" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,12"/>
                    <TextBlock Text="Socio" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbSocio" Style="{StaticResource ComboBoxOscuro}" Height="34" 
                              Margin="0,0,0,12" DisplayMemberPath="NombreCompleto"/>
                    <Button x:Name="btnRegistrarIngreso" Content="✅ REGISTRAR INGRESO" Height="38" 
                            Background="#3B82F6" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"
                            Click="btnRegistrarIngreso_Click"/>
                    <TextBlock x:Name="txtMensaje" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Ingresos de hoy -->
            <Border Grid.Column="1" Background="#181818" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🏋️ Ingresos de hoy" FontSize="14" FontWeight="SemiBold" 
                               Foreground="White" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" x:Name="dgAsistenciasHoy">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="250"/>
                            <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="110"/>
                            <DataGridTextColumn Header="Estado cuota" Binding="{Binding EstadoCuota}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Fila 2: historial por socio (RF-10) -->
        <Border Grid.Row="2" Background="#181818" CornerRadius="8" Padding="18" Margin="0,15,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="🕓 Historial de asistencias" FontSize="14" FontWeight="SemiBold" 
                           Foreground="White" Margin="0,0,0,12"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Socio:" Foreground="#AAAAAA" FontSize="12" 
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbSocioHistorial" Style="{StaticResource ComboBoxOscuro}" 
                              Width="300" Height="34" DisplayMemberPath="NombreCompleto"
                              SelectionChanged="cmbSocioHistorial_SelectionChanged"/>
                </StackPanel>
                <DataGrid Grid.Row="2" x:Name="dgHistorialSocio" Height="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="200"/>
                        <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" x:Name="txtSinHistorial" Foreground="#888888" FontSize="12" 
                           Margin="0,10,0,0" Visibility="Collapsed"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>