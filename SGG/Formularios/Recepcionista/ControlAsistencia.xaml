<Window x:Class="SGG.Formularios.Recepcionista.ControlAsistencia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:SGG.Controles"
        Title="SGG - Control de Asistencia" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <controles:MenuLateral x:Name="menuLateral" Grid.Column="0" SeccionActiva="Asistencia" />

        <!-- Contenido principal -->
        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="CONTROL DE ASISTENCIA" FontSize="24" FontWeight="Bold" 
                       Foreground="White" Margin="0,0,0,5"/>
            <TextBlock Grid.Row="0" Text="Registrar ingreso de socios" FontSize="13" 
                       Foreground="#888888" Margin="0,32,0,25" VerticalAlignment="Top"/>

            <!-- Buscador + registrar ingreso -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <ComboBox x:Name="cmbSocio" Width="320" Height="36" Margin="0,0,15,0"
                          DisplayMemberPath="NombreCompleto"/>
                <Button Content="✅  REGISTRAR INGRESO" Padding="18,8" 
                        Background="#3B82F6" Foreground="White" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand"
                        Click="btnRegistrarIngreso_Click"/>
            </StackPanel>

            <TextBlock x:Name="txtMensaje" Grid.Row="2" 
                       FontSize="13" TextWrapping="Wrap" 
                       Margin="0,0,0,20" Visibility="Collapsed"/>

            <!-- Historial del día -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="Ingresos de hoy" FontSize="16" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,15"/>
                <DataGrid x:Name="dgAsistencias" 
                          Background="#0D0D0D" Foreground="White" BorderThickness="0"
                          RowBackground="#0D0D0D" AlternatingRowBackground="#151515"
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          GridLinesVisibility="None" HeadersVisibility="Column"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="250"/>
                        <DataGridTextColumn Header="Hora de ingreso" Binding="{Binding Hora}" Width="150"/>
                        <DataGridTextColumn Header="Estado cuota" Binding="{Binding EstadoCuota}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

        </Grid>
    </Grid>
</Window>