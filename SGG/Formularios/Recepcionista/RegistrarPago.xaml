<UserControl x:Class="SGG.Formularios.Recepcionista.RegistrarPago"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Botón de comprobante del historial: pastilla azul tenue, mismo lenguaje que
             BotonBaja de GestionSociosAdmin. No es un CTA: el único botón sólido de la
             pantalla es REGISTRAR PAGO, así que acá el acento va en texto y borde. -->
        <Style x:Key="BotonComprobante" TargetType="Button">
            <Setter Property="Background" Value="#16233A"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="BorderBrush" Value="#2F4F7F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borde"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="#1D3557"/>
                                <Setter TargetName="Borde" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borde" Property="Background" Value="#23406B"/>
                                <Setter TargetName="Borde" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="REGISTRAR PAGO" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Registrar pagos de cuota y consultar el historial" FontSize="13" 
                           Foreground="#888888" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Formulario de carga -->
        <Border Grid.Row="1" Background="#181818" BorderBrush="#3B82F6" BorderThickness="0,3,0,0" 
                CornerRadius="8" Padding="18" Margin="0,0,0,15" 
                HorizontalAlignment="Left" Width="500" VerticalAlignment="Top">
            <StackPanel>

                <TextBlock Text="Socio" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbSocios" Style="{StaticResource ComboBoxOscuro}"
                          IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                          DisplayMemberPath="NombreConDni" SelectedValuePath="Id"
                          SelectionChanged="cmbSocios_SelectionChanged"
                          Margin="0,0,0,14"/>

                <!-- El precio YA NO se elige: sale de la membresía del socio seleccionado.
                     Es solo lectura y se completa solo en cmbSocios_SelectionChanged. -->
                <TextBlock Text="Precio (membresía)" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="txtPrecio" Height="34" Padding="8,0"
                         IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Método de pago" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbMetodoPago" Style="{StaticResource ComboBoxOscuro}" Height="34" Margin="0,0,0,12">
                    <ComboBoxItem Content="Efectivo"/>
                    <ComboBoxItem Content="Tarjeta"/>
                    <ComboBoxItem Content="Transferencia"/>
                </ComboBox>

                <TextBlock x:Name="txtError" 
                           Foreground="#FF5555" FontSize="12"
                           TextWrapping="Wrap" 
                           Margin="0,0,0,8" 
                           Visibility="Collapsed"/>
                <TextBlock x:Name="txtExito" 
                           Foreground="#5BE49B" FontSize="12"
                           TextWrapping="Wrap" 
                           Margin="0,0,0,8" 
                           Visibility="Collapsed"/>

                <Button Content="💵 REGISTRAR PAGO" Height="38" 
                        Background="#3B82F6" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Click="btnRegistrarPago_Click"/>

            </StackPanel>
        </Border>

        <!-- Pagos recientes -->
        <Border Grid.Row="2" Background="#181818" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🧾 Historial de pagos" FontSize="14" FontWeight="SemiBold" 
                               Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Grid Width="240" Height="30">
                            <TextBox x:Name="txtBuscarPago"
                                     Style="{StaticResource TextBoxConPlaceholder}"
                                     TextChanged="txtBuscarPago_TextChanged"/>
                            <TextBlock x:Name="hintBuscarPago" Text="Buscar por nombre o DNI..."
                                       Foreground="#666666" VerticalAlignment="Center" Margin="8,0,0,0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <DatePicker x:Name="dpFiltroFecha" Width="140" Margin="8,0,0,0" VerticalAlignment="Center"
                                    SelectedDateChanged="dpFiltroFecha_SelectedDateChanged"/>
                        <Button x:Name="btnLimpiarFiltros" Content="✕ Limpiar" Height="30" Padding="12,0" Margin="8,0,0,0"
                                Background="#2A2A3D" Foreground="White" BorderThickness="0" Cursor="Hand"
                                Click="btnLimpiarFiltros_Click"/>
                    </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" x:Name="dgPagos">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="200"/>
                        <DataGridTextColumn Header="DNI" Binding="{Binding Dni}" Width="110"/>
                        <DataGridTextColumn Header="Monto" Binding="{Binding Monto}" Width="120"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="120"/>
                        <DataGridTextColumn Header="Método" Binding="{Binding Metodo}" Width="140"/>
                        <DataGridTemplateColumn Header="Comprobante" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🧾 Ver"
                                            Style="{StaticResource BotonComprobante}"
                                            ToolTip="Ver el comprobante de este pago"
                                            Click="btnVerComprobante_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</UserControl>