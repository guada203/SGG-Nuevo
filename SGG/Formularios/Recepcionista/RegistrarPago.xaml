<Window x:Class="SGG.Formularios.Recepcionista.RegistrarPago"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:SGG.Controles"
        Title="SGG - Registrar Pago" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <controles:MenuLateral x:Name="menuLateral" Grid.Column="0" SeccionActiva="Pagos" />

        <!-- Contenido principal -->
        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="REGISTRAR PAGO" FontSize="24" FontWeight="Bold" 
                       Foreground="White" Margin="0,0,0,25"/>

            <!-- Formulario de carga -->
            <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" 
                    CornerRadius="6" Padding="25" Margin="0,0,0,25" HorizontalAlignment="Left" Width="500">
                <StackPanel>

                    <TextBlock Text="Socio" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbSocio" Height="34" Margin="0,0,0,15" 
                              DisplayMemberPath="NombreCompleto"/>

                    <TextBlock Text="Monto" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtMonto" Height="34" 
                             Background="#0D0D0D" Foreground="White" BorderBrush="#333333" 
                             Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Método de pago" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbMetodoPago" Height="34" Margin="0,0,0,20">
                        <ComboBoxItem Content="Efectivo"/>
                        <ComboBoxItem Content="Tarjeta"/>
                        <ComboBoxItem Content="Transferencia"/>
                    </ComboBox>

                    <TextBlock x:Name="txtError" 
                               Foreground="#FF5555" FontSize="12"
                               TextWrapping="Wrap" 
                               Margin="0,0,0,10" 
                               Visibility="Collapsed"/>

                    <Button Content="REGISTRAR PAGO" Height="38" 
                            Background="#3B82F6" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand"
                            Click="btnRegistrarPago_Click"/>

                </StackPanel>
            </Border>

            <!-- Historial de pagos recientes -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Pagos recientes" FontSize="16" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,15"/>
                <DataGrid x:Name="dgPagos" 
                          Background="#0D0D0D" Foreground="White" BorderThickness="0"
                          RowBackground="#0D0D0D" AlternatingRowBackground="#151515"
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          GridLinesVisibility="None" HeadersVisibility="Column"
                          CanUserAddRows="False" Height="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="200"/>
                        <DataGridTextColumn Header="Monto" Binding="{Binding Monto}" Width="120"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="120"/>
                        <DataGridTextColumn Header="Método" Binding="{Binding Metodo}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

        </Grid>
    </Grid>
</Window>