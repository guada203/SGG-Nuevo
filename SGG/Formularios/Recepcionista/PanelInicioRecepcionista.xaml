<UserControl x:Class="SGG.Formularios.Recepcionista.PanelInicioRecepcionista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock x:Name="txtSaludo" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Resumen del día" FontSize="13" 
                           Foreground="#888888" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock x:Name="txtFecha" FontSize="13" Foreground="#AAAAAA" 
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Tarjetas de KPIs -->
        <Grid Grid.Row="1" Margin="0,25,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Socios activos -->
            <Border Grid.Column="0" Background="#181818" BorderBrush="#3B82F6" Margin="0,0,15,0" 
                    BorderThickness="0,3,0,0" CornerRadius="8">
                <StackPanel Margin="18" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="#888888">
                        <Run Text="👥 "/><Run Text="Socios activos"/>
                    </TextBlock>
                    <TextBlock x:Name="txtKpiSociosActivos" Text="—" FontSize="26" FontWeight="Bold" 
                               Foreground="#3B82F6" Margin="0,5,0,0"/>
                    <TextBlock x:Name="txtTendenciaSocios" Text="▲ +2 vs. mes anterior" FontSize="10" 
                               Foreground="#5BE49B" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Ingresos del mes -->
            <Border Grid.Column="1" Background="#181818" BorderBrush="#3B82F6" Margin="0,0,15,0" 
                    BorderThickness="0,3,0,0" CornerRadius="8">
                <StackPanel Margin="18" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="#888888">
                        <Run Text="💰 "/><Run x:Name="runEtiquetaIngresos" Text="Ingresos del mes"/>
                    </TextBlock>
                    <TextBlock x:Name="txtKpiIngresosMes" Text="—" FontSize="26" FontWeight="Bold" 
                               Foreground="#3B82F6" Margin="0,5,0,0"/>
                    <TextBlock x:Name="txtTendenciaIngresos" Text="● Sin cambios" FontSize="10" 
                               Foreground="#888888" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Cuotas por vencer (alerta) -->
            <Border Grid.Column="2" Background="#26F59E0B" BorderBrush="#F59E0B" 
                    BorderThickness="1" CornerRadius="8">
                <StackPanel Margin="18" VerticalAlignment="Center">
                    <TextBlock FontSize="12" Foreground="#888888">
                        <Run Text="⏳ "/><Run Text="Cuotas por vencer"/>
                    </TextBlock>
                    <TextBlock Text="próximos 30 días" FontSize="10" Foreground="#E6B800" Margin="0,1,0,0"/>
                    <TextBlock x:Name="txtKpiCuotasPorVencer" Text="—" FontSize="26" FontWeight="Bold" 
                               Foreground="#F59E0B" Margin="0,3,0,0"/>
                    <TextBlock x:Name="txtTendenciaCuotas" Text="▲ 0 próx. 30 días" FontSize="10" 
                               Foreground="#F59E0B" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Alerta de socios con la cuota vencida -->
        <Border x:Name="panelVencidos" Grid.Row="2" Background="#0D5BE49B" BorderBrush="#5BE49B"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock x:Name="txtTituloVencidos" Text="✓ No hay socios con cuota vencida"
                           FontSize="13" FontWeight="SemiBold" Foreground="#5BE49B"/>
                <ScrollViewer x:Name="scrollVencidos" MaxHeight="120" Margin="0,10,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <WrapPanel x:Name="wpVencidos"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Área inferior: gráficos y actividad reciente -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Gráfico de barras: ingresos -->
            <Border Grid.Row="0" Grid.Column="0" Background="#181818" CornerRadius="8" Padding="18" Margin="0,0,15,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📈 Ingresos últimos 6 meses" FontSize="14" 
                               FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>
                    <StackPanel Grid.Row="1" x:Name="spBarras" Orientation="Horizontal" 
                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>

            <!-- Actividad reciente -->
            <Border Grid.Row="0" Grid.Column="1" Background="#181818" CornerRadius="8" Padding="18" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🕓 Actividad reciente" FontSize="14" 
                               FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                    <StackPanel Grid.Row="1" x:Name="spActividad"/>
                </Grid>
            </Border>

            <!-- Gráfico dinámico: socios ingresados por mes del año seleccionado -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#181818" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👥 Socios por año de ingreso" FontSize="14" 
                                   FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Año:" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbAnioIngreso" Width="100"
                                      Style="{StaticResource ComboBoxOscuro}"
                                      SelectionChanged="cmbAnioIngreso_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" x:Name="spBarrasIngresoMes" Orientation="Horizontal"
                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MinHeight="170"/>
                </Grid>
            </Border>

        </Grid>

    </Grid>
    </ScrollViewer>
</UserControl>