<Window x:Class="SGG.Formularios.Entrenador.VentanaMisAlumnos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGG - Mis Alumnos" Height="600" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0D">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Mis Alumnos" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
		<TextBlock Grid.Row="1" Text="Socios asignados a vos como entrenadora" FontSize="12" Foreground="#888888" Margin="0,0,0,20"/>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Columna: Sin rutina -->
			<Border Grid.Column="0" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="18">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="Sin Rutina Asignada" FontSize="14" FontWeight="Bold"
                               Foreground="#F59E0B" Margin="0,0,0,12"/>
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<ItemsControl x:Name="icSinRutina">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1"
                                            CornerRadius="6" Padding="14" Margin="0,0,0,10">
										<DockPanel>
											<Button DockPanel.Dock="Right" Content="Asignar Rutina"
                                                    Click="btnAsignar_Click" Tag="{Binding}"
                                                    Background="#A855F7" Foreground="White" BorderThickness="0"
                                                    Padding="10,6" VerticalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="{Binding NombreCompleto}" Foreground="White" FontWeight="Bold" FontSize="13"/>
												<TextBlock Text="{Binding Dni}" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
											</StackPanel>
										</DockPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</DockPanel>
			</Border>

			<!-- Columna: Con rutina -->
			<Border Grid.Column="2" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="18">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="Con Rutina Activa" FontSize="14" FontWeight="Bold"
                               Foreground="#22C55E" Margin="0,0,0,12"/>
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<ItemsControl x:Name="icConRutina">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1"
                                            CornerRadius="6" Padding="14" Margin="0,0,0,10">
										<DockPanel>
											<Button DockPanel.Dock="Right" Content="Editar Rutina"
                                                    Click="btnEditar_Click" Tag="{Binding}"
                                                    Background="#2A2A3D" Foreground="#A855F7" BorderBrush="#A855F7"
                                                    Padding="10,6" VerticalAlignment="Center"/>
											<StackPanel VerticalAlignment="Center">
												<TextBlock Text="{Binding NombreCompleto}" Foreground="White" FontWeight="Bold" FontSize="13"/>
												<TextBlock Text="{Binding Dni}" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
												<TextBlock Text="{Binding RutinaActual.Nombre}" Foreground="#22C55E" FontSize="11" Margin="0,4,0,0"/>
											</StackPanel>
										</DockPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</DockPanel>
			</Border>
		</Grid>
	</Grid>
</Window>