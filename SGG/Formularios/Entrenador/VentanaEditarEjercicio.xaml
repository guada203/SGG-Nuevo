<Window x:Class="SGG.Formularios.Entrenador.VentanaEditarEjercicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio" Height="480" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D0D0D">

	<Grid Margin="25">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="txtTitulo" Grid.Row="0" Text="Nuevo Ejercicio" FontSize="20" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,20"/>

		<StackPanel Grid.Row="1">
			<TextBlock Text="Nombre del ejercicio" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
			<TextBox x:Name="txtNombre" Background="#1A1A1A" Foreground="White" BorderBrush="#333333" Padding="8" Margin="0,0,0,14"/>

			<TextBlock Text="Grupo muscular" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
			<TextBox x:Name="txtGrupoMuscular" Background="#1A1A1A" Foreground="White" BorderBrush="#333333" Padding="8" Margin="0,0,0,14"/>

			<Grid Margin="0,0,0,14">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0">
					<TextBlock Text="Series" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
					<TextBox x:Name="txtSeries" Background="#1A1A1A" Foreground="White" BorderBrush="#333333" Padding="8"/>
				</StackPanel>
				<StackPanel Grid.Column="2">
					<TextBlock Text="Repeticiones" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
					<TextBox x:Name="txtRepeticiones" Background="#1A1A1A" Foreground="White" BorderBrush="#333333" Padding="8"/>
				</StackPanel>
			</Grid>

			<TextBlock Text="Descanso (segundos)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
			<TextBox x:Name="txtDescanso" Background="#1A1A1A" Foreground="White" BorderBrush="#333333" Padding="8" Margin="0,0,0,14"/>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button x:Name="btnCancelar" Content="Cancelar" Width="90" Height="36"
                    Background="#222222" Foreground="#CCCCCC" BorderBrush="#333333" Margin="0,0,10,0"
                    Click="btnCancelar_Click"/>
			<Button x:Name="btnGuardar" Content="Guardar" Width="110" Height="36"
                    Background="#A855F7" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                    Click="btnGuardar_Click"/>
		</StackPanel>
	</Grid>
</Window>