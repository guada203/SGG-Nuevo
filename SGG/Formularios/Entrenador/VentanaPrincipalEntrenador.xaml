<Window x:Class="SGG.Formularios.Entrenador.VentanaPrincipalEntrenador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:SGG.Controles"
        Title="SGG - Entrenador" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <controles:MenuLateral x:Name="menuLateral" Grid.Column="0" SeccionActiva="Inicio" />
        <ContentControl x:Name="contenido" Grid.Column="1"/>
    </Grid>
</Window>