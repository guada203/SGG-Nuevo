<Window x:Class="SGG.Formularios.Entrenador.VentanaPrincipalEntrenador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:SGG.Controles"
        Title="SGG - Entrenador" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <controles:MenuLateral x:Name="menuLateral" Grid.Column="0" SeccionActiva="Inicio" />

        <!-- Panel principal -->
        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado con botón -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtBienvenida" Text="¡Bienvenida, Entrenadora!" 
                               FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtFecha" Text="Fecha" FontSize="12" 
                               Foreground="#888888" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Crear Nueva Rutina" 
                        Background="#A855F7" Foreground="White" Padding="14,8" 
                        BorderThickness="0" Click="btnCrearRutina_Click"/>
            </Grid>

            <!-- Tarjetas de estadísticas -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,25">

                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" 
                        CornerRadius="6" Width="185" Height="90" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center" Margin="16">
                        <TextBlock Text="Rutinas Creadas" FontSize="11" Foreground="#888888"/>
                        <TextBlock x:Name="txtRutinasCreadas" Text="—" FontSize="24" FontWeight="Bold" 
                                   Foreground="#22C55E" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" 
                        CornerRadius="6" Width="185" Height="90" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center" Margin="16">
                        <TextBlock Text="Socios Asignados" FontSize="11" Foreground="#888888"/>
                        <TextBlock x:Name="txtSociosAsignados" Text="—" FontSize="24" FontWeight="Bold" 
                                   Foreground="#3B82F6" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" 
                        CornerRadius="6" Width="185" Height="90" Margin="0,0,15,0">
                    <StackPanel VerticalAlignment="Center" Margin="16">
                        <TextBlock Text="Rutinas Activas" FontSize="11" Foreground="#888888"/>
                        <TextBlock x:Name="txtRutinasActivas" Text="—" FontSize="24" FontWeight="Bold" 
                                   Foreground="#A855F7" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" 
                        CornerRadius="6" Width="185" Height="90">
                    <StackPanel VerticalAlignment="Center" Margin="16">
                        <TextBlock Text="Rutinas Pendientes" FontSize="11" Foreground="#888888"/>
                        <TextBlock x:Name="txtRutinasPendientes" Text="—" FontSize="24" FontWeight="Bold" 
                                   Foreground="#F59E0B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Tabla + panel lateral -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rutinas recientes -->
                <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#333333" 
                        BorderThickness="1" CornerRadius="6" Padding="18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Rutinas Recientes" 
                                   FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <DataGrid x:Name="dgRutinasRecientes" AutoGenerateColumns="False" 
                                  Background="#1A1A1A" Foreground="White" BorderThickness="0"
                                  RowBackground="#1A1A1A" AlternatingRowBackground="#222222"
                                  GridLinesVisibility="None" HeadersVisibility="None"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="110"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="90"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Socios sin rutina -->
                <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#333333" 
                        BorderThickness="1" CornerRadius="6" Padding="18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Socios sin Rutina" 
                                   FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="icSociosSinRutina">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#222222" CornerRadius="4" 
                                            Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}" Foreground="White" 
                                                       FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding Meta}" Foreground="#888888" 
                                                       FontSize="10" Margin="0,2,0,6"/>
                                            <Button Content="Asignar Rutina" 
                                                    Background="#A855F7" Foreground="White" 
                                                    BorderThickness="0" Padding="6,4" FontSize="11"
                                                    HorizontalAlignment="Left"
                                                    Click="btnAsignarDesdeInicio_Click"
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>