<Window x:Class="SGG.Formularios.Entrenador.VentanaListaRutinas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:SGG.Controles"
        Title="SGG - Mis Rutinas" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Menú lateral -->
		<controles:MenuLateral x:Name="menuLateral" Grid.Column="0" SeccionActiva="Rutinas" />

		<!-- Contenido principal -->
		<Grid Grid.Column="1" Margin="30">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Encabezado: título, buscador, botón crear -->
			<DockPanel Grid.Row="0" Margin="0,0,0,15">
				<TextBlock Text="Mis Rutinas" FontSize="26" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left"/>
				<Button x:Name="btnCrearRutina" Content="+ Crear Nueva Rutina" DockPanel.Dock="Right"
                        Background="#A855F7" Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Padding="14,8" HorizontalAlignment="Right"
                        Click="btnCrearRutina_Click"/>
				<TextBox x:Name="txtBuscar" Background="#1A1A1A" Foreground="White" BorderBrush="#333333"
                         Padding="8" Margin="20,0" VerticalContentAlignment="Center"
                         TextChanged="txtBuscar_TextChanged"/>
			</DockPanel>

			<!-- Filtros -->
			<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
				<Button x:Name="btnFiltroTodas" Content="Todas" Click="btnFiltro_Click" Tag="Todas"
                        Background="#A855F7" Foreground="White" BorderThickness="0" Padding="14,6" Margin="0,0,8,0"/>
				<Button x:Name="btnFiltroActivas" Content="Activas" Click="btnFiltro_Click" Tag="Activa"
                        Background="#1A1A1A" Foreground="#CCCCCC" BorderBrush="#333333" Padding="14,6" Margin="0,0,8,0"/>
				<Button x:Name="btnFiltroPendientes" Content="Pendientes" Click="btnFiltro_Click" Tag="Pendiente"
                        Background="#1A1A1A" Foreground="#CCCCCC" BorderBrush="#333333" Padding="14,6" Margin="0,0,8,0"/>
				<Button x:Name="btnFiltroCompletadas" Content="Completadas" Click="btnFiltro_Click" Tag="Completada"
                        Background="#1A1A1A" Foreground="#CCCCCC" BorderBrush="#333333" Padding="14,6"/>
			</StackPanel>

			<!-- Grid de tarjetas -->
			<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
				<ItemsControl x:Name="icRutinas">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1"
                                    CornerRadius="8" Width="320" Padding="18" Margin="0,0,15,15">
								<StackPanel>
									<DockPanel Margin="0,0,0,8">
										<TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="Bold"
                                                   Foreground="White" DockPanel.Dock="Left"/>
										<Border Background="{Binding ColorEstado}" CornerRadius="4"
                                                Padding="8,3" HorizontalAlignment="Right">
											<TextBlock Text="{Binding Estado}" FontSize="10" Foreground="White"/>
										</Border>
									</DockPanel>

									<TextBlock Text="{Binding SocioNombre}" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,2"/>
									<TextBlock Text="{Binding FechaCreacionTexto}" Foreground="#888888" FontSize="11" Margin="0,0,0,10"/>

									<TextBlock Foreground="#888888" FontSize="11" Margin="0,0,0,14">
										<Run Text="{Binding DuracionSemanas}"/>
										<Run Text="semanas  •  "/>
										<Run Text="{Binding CantidadEjercicios}"/>
										<Run Text="ejercicios"/>
									</TextBlock>

									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="8"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>
										<Button Grid.Column="0" Content="Editar" Click="btnEditar_Click" Tag="{Binding}"
                                                Background="#222222" Foreground="#CCCCCC" BorderBrush="#333333" Padding="0,7"/>
										<Button Grid.Column="2" Content="Ver Detalle" Click="btnVerDetalle_Click" Tag="{Binding}"
                                                Background="#A855F7" Foreground="White" BorderThickness="0" Padding="0,7"/>
									</Grid>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Grid>
</Window>