<Window x:Class="SGG.Formularios.Login.VentanaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGG - Iniciar Sesión" Height="450" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D0D0D">

    <StackPanel VerticalAlignment="Center" Margin="40">

        <TextBlock Text="SGG" FontSize="28" FontWeight="Bold" 
                   Foreground="White" HorizontalAlignment="Center"/>

        <TextBlock x:Name="txtRolSeleccionado" 
                   Text="Ingresando como Recepcionista" 
                   FontSize="13" Foreground="#C5FF00" 
                   HorizontalAlignment="Center" Margin="0,5,0,30"/>

        <TextBlock Text="Email" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
        <TextBox x:Name="txtEmail" Height="34" 
                 Background="#1A1A1A" Foreground="White" 
                 BorderBrush="#333333" Padding="8,0" 
                 VerticalContentAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock Text="Contraseña" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
        <!-- Overlay contraseña: PasswordBox (oculto) + TextBox (claro), alternados por el botón ojo.
             Ambos se mantienen sincronizados para que btnIngresar siempre lea txtPassword.Password. -->
        <Grid Height="34" Margin="0,0,0,10">
            <PasswordBox x:Name="txtPassword" Height="34"
                         Background="#1A1A1A" Foreground="White"
                         BorderBrush="#333333" Padding="8,0,36,0"
                         VerticalContentAlignment="Center"/>
            <TextBox x:Name="txtPasswordVisible" Height="34"
                     Background="#1A1A1A" Foreground="White"
                     BorderBrush="#333333" Padding="8,0,36,0"
                     VerticalContentAlignment="Center"
                     TextChanged="txtPasswordVisible_TextChanged"
                     Visibility="Collapsed"/>
            <Button x:Name="btnVerPassword" Click="btnVerPassword_Click"
                    Width="36" Height="34" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#666666"
                    Content="&#xE7B3;" ToolTip="Ver contraseña"/>
        </Grid>

        <TextBlock x:Name="txtError" 
                   Foreground="#FF5555" FontSize="12"
                   TextWrapping="Wrap" 
                   Margin="0,0,0,15" 
                   Visibility="Collapsed"/>

        <Button x:Name="btnIngresar" Content="INGRESAR" Height="38" 
                Background="#C5FF00" Foreground="Black" FontWeight="Bold"
                BorderThickness="0" Cursor="Hand"
                Click="btnIngresar_Click" Margin="0,0,0,10"/>

        <TextBlock Text="← Volver a selección de rol" 
                   Foreground="#666666" FontSize="11" 
                   HorizontalAlignment="Center" 
                   Cursor="Hand" 
                   MouseLeftButtonUp="Volver_Click"/>

    </StackPanel>
</Window>